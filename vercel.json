{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/build",
  "framework": "create-react-app",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/members/:path*",
      "destination": "/api/members"
    },
    {
      "source": "/api/coupon-claim",
      "destination": "/api/coupon-claim"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sunriseyouth.org"
        }
      ],
      "destination": "https://www.sunriseyouth.org/:path*",
      "permanent": true
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
