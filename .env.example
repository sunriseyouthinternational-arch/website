PORT=5000
MONGODB_URI=mongodb://localhost:27017/sunrise-youth
JWT_SECRET=your_jwt_secret_key_change_this_in_production
NODE_ENV=development

# Google Sheets Integration (Optional)
# Get these from Google Cloud Console - see GOOGLE_SHEETS_SETUP.md
GOOGLE_SHEET_ID=your_spreadsheet_id_here
# Option A: Path to service account JSON file (for development)
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account-key.json
# Option B: Service account JSON as string (for production)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
